# Local test database (used by integration + e2e tests)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobquest_test

# Clerk development instance keys (e2e only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# An existing user in that Clerk instance used by e2e tests
E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com
# Optional: run against a deployed URL instead of a local build
# E2E_BASE_URL=https://jobquest.example.workers.dev
