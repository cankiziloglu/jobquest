// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// prisma-client-js (generated into node_modules) is used deliberately: the
// @prisma/client package resolves a workerd-specific build via export
// conditions, which OpenNext relies on for Cloudflare Workers, while Node.js
// (dev, tests) gets the regular build.
generator client {
  provider = "prisma-client-js"
}

// Connection URL is configured in prisma.config.ts
datasource db {
  provider = "postgresql"
}

enum JobStatus {
  WISHLIST
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

enum WorkArrangement {
  REMOTE
  ON_SITE
  HYBRID
}

model Job {
  id              String           @id @default(cuid())
  userId          String // Clerk user ID
  title           String
  company         String
  description     String?
  location        String?
  salary          String?
  jobUrl          String?
  workArrangement WorkArrangement?
  status          JobStatus        @default(WISHLIST)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relationship: one job can have multiple notes
  notes Note[]

  @@map("jobs")
}

model Note {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign key to Job
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("notes")
}
